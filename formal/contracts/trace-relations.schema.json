{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rag-guide/trace-relations.schema.json",
  "title": "Trace relation event",
  "type": "object",
  "required": ["event_id", "event_type", "trace_id", "request_id", "release_id"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["REQUEST", "CANDIDATE", "EVIDENCE", "CLAIM", "CITATION", "TOOL_CALL", "FALLBACK", "ROLLBACK"]},
    "trace_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "release_id": {"type": "string", "minLength": 1},
    "dataset_item_id": {"type": ["string", "null"]},
    "candidate_id": {"type": ["string", "null"]},
    "evidence_id": {"type": ["string", "null"]},
    "claim_id": {"type": ["string", "null"]},
    "citation_id": {"type": ["string", "null"]},
    "tool_call_id": {"type": ["string", "null"]},
    "retry_of": {"type": ["string", "null"]},
    "parent_event_id": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
