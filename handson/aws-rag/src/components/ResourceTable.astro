---
interface Row {
  resource: string;
  setting: string;
  value: string;
  note?: string;
}

interface Props {
  title?: string;
  rows: Row[];
}

const { title = '作成・設定する値', rows } = Astro.props;
---

<section class="resource-table-section" aria-label={title}>
  <h2 class="resource-table-title">{title}</h2>
  <div class="resource-table-scroll">
    <table class="resource-table">
      <thead>
        <tr>
          <th scope="col">対象</th>
          <th scope="col">設定項目</th>
          <th scope="col">このハンズオンの値</th>
          <th scope="col">意味・確認ポイント</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <th scope="row">{row.resource}</th>
            <td>{row.setting}</td>
            <td><code>{row.value}</code></td>
            <td>{row.note ?? ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>