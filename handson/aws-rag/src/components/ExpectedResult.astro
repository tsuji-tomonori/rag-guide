---
interface Props {
  title?: string;
  id?: string;
  verification?: string;
  checks?: string[];
}

const {
  title = 'こうなれば成功',
  id,
  verification,
  checks,
} = Astro.props;
---

<aside class="expected-result" data-check-source data-result-id={id} data-result-title={title}>
  <div class="result-icon" aria-hidden="true">✓</div>
  <div>
    <strong>{title}</strong>
    {verification && (
      <p class="result-perspective">
        <strong>確認の観点</strong>
        <span>「{verification}」で、件数・値・状態が期待どおりかを確認します。</span>
      </p>
    )}
    <div class="result-content">
      {checks && <ul>{checks.map((check) => (
        <li><label class="check-item"><input type="checkbox" data-result-check /><span>{check}</span></label></li>
      ))}</ul>}
      <slot />
    </div>
  </div>
</aside>
